# Copier ce fichier en `.env` (`cp .env.example .env`) : l'application et
# docker-compose.yaml le lisent au démarrage.

# ┌─ Authentification ────────────────────────────────────────────────────────┐
# `dev` : connexion de développement (GET /dev/login), sans fournisseur
# d'identité. N'importe qui peut se connecter en tant que n'importe quel
# utilisateur : NE JAMAIS UTILISER EN PRODUCTION.
# `entra` (défaut si absent) : Microsoft Entra ID, voir la section plus bas.
AUTH_MODE=dev

# Clé optionnelle exigée par la connexion de développement (vide = connexion
# ouverte). Ignorée avec AUTH_MODE=entra.
DEV_LOGIN_KEY=

# Domaines e-mail autorisés, séparés par des virgules.
ALLOWED_DOMAINS=epf.fr,epfedu.fr

# Clé de signature des cookies de session. À renseigner avec une valeur
# longue et aléatoire, par exemple : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Microsoft Entra ID (requis avec AUTH_MODE=entra) ────────────────────────┐
# Laisser commentées en mode dev. Décommenter et renseigner les quatre
# variables pour AUTH_MODE=entra : l'application refuse de démarrer si l'une
# des trois premières manque.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=
# REDIRECT_URI=https://[CHANGE_THIS]/auth/callback
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Base de données ─────────────────────────────────────────────────────────┐
# Dossier de la base SQLite (défaut : database/ à la racine du projet).
# Avec docker compose, dossier de l'hôte monté dans le conteneur.
LOCAL_DATABASE_DIR=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Synthèses LLM ───────────────────────────────────────────────────────────┐
# Clé du fournisseur LLM par défaut. Vide : l'application démarre, mais les
# synthèses demandées sont marquées en erreur de configuration.
LLM_API_KEY=

# Mettre à 1 pour lancer le daemon de synthèses en parallèle d'uvicorn.
# Laisser vide/absent en production (launch.sh gère déjà le daemon).
RUN_SUMMARIES_DAEMON=
# └───────────────────────────────────────────────────────────────────────────┘
