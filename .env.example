# Copy this file to `.env` (`cp .env.example .env`): the application and
# docker-compose.yaml read it at startup. Every variable is described once, in
# the README's "Configuration" section.

# ┌─ Authentication ──────────────────────────────────────────────────────────┐
# `dev` lets a fork start without Entra credentials: anyone can sign in as
# anyone. NEVER USE IN PRODUCTION: a deployment leaves AUTH_MODE unset or
# sets it to `entra`.
AUTH_MODE=dev

# Optional key required by the development sign-in (empty = open sign-in).
DEV_LOGIN_KEY=

ALLOWED_DOMAINS=epf.fr,epfedu.fr

# Required under `entra`; optional under `dev`. See the README before setting it.
SECRET_KEY=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Microsoft Entra ID (required with AUTH_MODE=entra) ──────────────────────┐
# Keep commented out under `dev`.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=
# REDIRECT_URI=https://[CHANGE_THIS]/auth/callback
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Database ────────────────────────────────────────────────────────────────┐
# Empty = database/ at the repository root.
LOCAL_DATABASE_DIR=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ LLM summaries ───────────────────────────────────────────────────────────┐
# Empty: the application starts, but requested summaries fail.
LLM_API_KEY=

# 1 = start the summaries daemon alongside uvicorn.
RUN_SUMMARIES_DAEMON=
# └───────────────────────────────────────────────────────────────────────────┘
